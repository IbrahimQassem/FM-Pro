rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isKnownBase(base) {
      return base in ['HudHudFM', 'HudHudFmGooglePlay', 'InterNews'];
    }

    function userPath(base) {
      return /databases/$(database)/documents/$(base)/Users/Users/$(request.auth.uid);
    }

    function roleFor(base) {
      return isSignedIn() && isKnownBase(base) && exists(userPath(base))
        ? get(userPath(base)).data.userType
        : 'USER';
    }

    function isAdmin(base) {
      return roleFor(base) in ['ADMIN', 'SuperADMIN'];
    }

    function isSuperAdmin(base) {
      return roleFor(base) == 'SuperADMIN';
    }

    function selfProfileFieldsAreSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userType',
        'allowedPermissions',
        'disabled',
        'stopNote',
      ]);
    }

    match /{base}/RadioInfo/RadioInfo/{radioId} {
      allow read: if isKnownBase(base);
      allow write: if isAdmin(base);
    }

    match /{base}/RadioProgram/{radioId}/RadioProgram/RadioProgram/{programId} {
      allow read: if isKnownBase(base);
      allow write: if isAdmin(base);
    }

    match /{base}/Episode/{radioId}/Episode/Episode/{episodeId} {
      allow read: if isKnownBase(base);
      allow write: if isAdmin(base);
    }

    match /{base}/Advertisement/Advertisement/{adId} {
      allow read: if isKnownBase(base);
      allow write: if isAdmin(base);
    }

    match /{base}/Users/Users/{userId} {
      allow read: if isSignedIn() && isKnownBase(base)
        && (request.auth.uid == userId || isAdmin(base));

      allow create: if isSignedIn() && isKnownBase(base)
        && request.auth.uid == userId
        && request.resource.data.userType == 'USER';

      allow update: if isKnownBase(base)
        && (
          isSuperAdmin(base)
          || (
            isSignedIn()
            && request.auth.uid == userId
            && selfProfileFieldsAreSafe()
          )
        );

      allow delete: if isSuperAdmin(base);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
