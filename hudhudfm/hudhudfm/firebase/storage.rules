rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleFor(base) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/$(base)/Users/Users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/$(base)/Users/Users/$(request.auth.uid)).data.userType
        : 'USER';
    }

    function isAdmin(base) {
      return roleFor(base) in ['ADMIN', 'SuperADMIN'];
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /HudHudFM_Folder/{parentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin('HudHudFM') && isImageUpload();
    }

    match /HudHudFmGooglePlay_Folder/{parentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin('HudHudFmGooglePlay') && isImageUpload();
    }

    match /InterNews_Folder/{parentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin('InterNews') && isImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
