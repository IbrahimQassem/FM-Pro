rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isKnownRoot(root) {
      return root == 'HudHudFM'
        || root == 'HudHudFmGooglePlay'
        || root == 'InterNews';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validOwnUserCreate(uid) {
      let data = request.resource.data;
      return isOwner(uid)
        && data.keys().hasAll(['displayName', 'isActive', 'role'])
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.isActive == true
        && data.role == 'listener';
    }

    function validOwnUserUpdate(uid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isOwner(uid)
        && changed.hasOnly([
          'displayName', 'username', 'email', 'phoneNumber', 'avatarUrl',
          'bio', 'city', 'country', 'gender', 'authProvider', 'isOnline',
          'lastActiveAt', 'updatedAt'
        ])
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 60));
    }

    function validCommentCreate(episodeId, commentId) {
      let data = request.resource.data;
      return isSignedIn()
        && data.keys().hasAll(['episodeId', 'author', 'content', 'likesCount'])
        && data.episodeId == episodeId
        && data.author.uid == request.auth.uid
        && data.author.displayName is string
        && data.author.displayName.size() <= 120
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 1000
        && data.likesCount == 0;
    }

    function validCommentEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (isOwner(resource.data.author.uid) || isAdmin())
        && changed.hasOnly(['content', 'isEdited', 'updatedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
    }

    // ==========================================
    // CANONICAL STANDARD COLLECTIONS
    // ==========================================

    match /{root}/stations/{stationId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    match /{root}/programs/{programId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    match /{root}/episodes/{episodeId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();

      // Subcollection for Likes: Scalable 1-read per user, atomic counters on parent
      match /likes/{uid} {
        allow read: if isKnownRoot(root);
        allow create, delete: if isKnownRoot(root) && isOwner(uid);
      }

      // Subcollection for Comments
      match /comments/{commentId} {
        allow read: if isKnownRoot(root);
        allow create: if isKnownRoot(root) && validCommentCreate(episodeId, commentId);
        allow update: if isKnownRoot(root) && validCommentEdit();
        allow delete: if isKnownRoot(root) && (isOwner(resource.data.author.uid) || isAdmin());
      }
    }

    match /{root}/users/{uid} {
      allow get: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
      allow list: if isKnownRoot(root) && isAdmin();
      allow create: if isKnownRoot(root) && (isAdmin() || validOwnUserCreate(uid));
      allow update: if isKnownRoot(root) && (isAdmin() || validOwnUserUpdate(uid));
      allow delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());

      match /favorites/{favoriteId} {
        allow read, create, update, delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
      }

      match /subscriptions/{programId} {
        allow read, create, update, delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
      }
    }

    match /{root}/banners/{bannerId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    // ==========================================
    // LEGACY COLLECTIONS (Preserved for compatibility)
    // ==========================================

    match /{root}/RadioInfo/RadioInfo/{radioId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    match /{root}/RadioProgram/{radioId}/RadioProgram/RadioProgram/{programId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    match /{root}/Episode/{radioId}/Episode/Episode/{episodeId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();

      match /Comment/{commentId} {
        allow read: if isKnownRoot(root);
        allow create, update, delete: if isKnownRoot(root) && (isSignedIn() || isAdmin());
      }
    }

    match /{root}/Users/Users/{uid} {
      allow get, list, create, update, delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
      match /favorites/{favoriteId} {
        allow read, create, update, delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
      }
    }

    match /{root}/Advertisement/Advertisement/{advertisementId} {
      allow read: if isKnownRoot(root);
      allow create, update, delete: if isKnownRoot(root) && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
