<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Typography and Component Style Tokens -->
<resources>
    <!-- Typography Styles -->
    <style name="TextAppearance.FMPro.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">57sp</item>
    </style>

    <style name="TextAppearance.FMPro.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.FMPro.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.FMPro.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.FMPro.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.FMPro.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.FMPro.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.FMPro.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.FMPro.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.FMPro.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.FMPro.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.FMPro.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.FMPro.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/md_theme_outline</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Accessible Button Style Tokens (Min touch target 48dp) -->
    <style name="Widget.FMPro.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target_size</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
    </style>

    <style name="Widget.FMPro.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/min_touch_target_size</item>
        <item name="backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSecondaryContainer</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
    </style>

    <style name="Widget.FMPro.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target_size</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="cornerRadius">@dimen/corner_radius_full</item>
    </style>
</resources>
