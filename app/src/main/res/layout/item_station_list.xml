<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_station"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginVertical="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="@dimen/corner_radius_md"
        app:cardElevation="@dimen/elevation_level1"
        app:rippleColor="?attr/colorControlHighlight"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <!-- Station Logo -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.sana.dev.fm.ui.view.RoundImageView
                    android:id="@+id/civ_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="centerCrop"
                    app:borderColor="@color/md_theme_outlineVariant"
                    app:borderWidth="1dp"
                    app:cornerRadius="14dp"
                    app:srcCompat="@mipmap/ic_launcher" />

                <ImageView
                    android:id="@+id/iv_badge_image"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_verified"
                    app:tint="@color/md_theme_primary" />
            </FrameLayout>

            <!-- Middle Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_station_name"
                    style="@style/TextAppearance.FMPro.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurface"
                    tools:text="راديو هوا اليمن" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_frequency"
                        style="@style/TextAppearance.FMPro.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_round_corner"
                        android:backgroundTint="@color/md_theme_station_chip_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/md_theme_primary"
                        tools:text="88.3 MHz" />

                    <TextView
                        android:id="@+id/tv_location"
                        style="@style/TextAppearance.FMPro.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        tools:text="صنعاء" />

                    <!-- Live Badge -->
                    <LinearLayout
                        android:id="@+id/lyt_live_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_round_corner"
                        android:backgroundTint="@color/md_theme_errorContainer"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/md_theme_error" />

                        <TextView
                            style="@style/TextAppearance.FMPro.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_live_badge"
                            android:textColor="@color/md_theme_onErrorContainer"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Quick Play Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_play"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/action_play_stream"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
