<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginVertical="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="@dimen/corner_radius_xl"
        app:cardElevation="@dimen/elevation_level2"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/lyt_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Header: Station Avatar + Program Info + Live/Time Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_sm">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/civ_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp"
                    tools:srcCompat="@drawable/logo_app" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/TextAppearance.FMPro.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_onSurface"
                        tools:text="@string/label_program_name" />

                    <TextView
                        android:id="@+id/tv_announcer"
                        style="@style/TextAppearance.FMPro.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_theme_primary"
                        tools:text="@string/label_announcer_name" />

                </LinearLayout>

                <!-- Live Time Pill Badge -->
                <TextView
                    android:id="@+id/tv_time"
                    style="@style/TextAppearance.FMPro.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_round_corner"
                    android:backgroundTint="@color/md_theme_live_container"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/md_theme_live_red"
                    tools:text="@string/ex_time" />

            </LinearLayout>

            <!-- Media Banner Image with Rounded Corners -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginHorizontal="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_xs">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                    app:srcCompat="@drawable/logo_app" />

            </FrameLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_desc"
                style="@style/TextAppearance.FMPro.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm"
                android:textColor="@color/md_theme_onSurfaceVariant"
                tools:text="@string/lorem_ipsum" />

            <!-- Date & Broadcast State Metadata -->
            <LinearLayout
                android:id="@+id/lyt_parent_date_announcer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs">

                <TextView
                    android:id="@+id/tv_state"
                    style="@style/TextAppearance.FMPro.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_primary"
                    tools:text="@string/label_display_now" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_date"
                    style="@style/TextAppearance.FMPro.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_outline"
                    tools:text="@string/ex_date" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Interactive Action Bar: Likes, Comments, More (WCAG Min 48dp touch targets) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <!-- Likes Button -->
                <LinearLayout
                    android:id="@+id/lyt_like_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:id="@+id/imv_like"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/label_like"
                        app:srcCompat="@drawable/ic_thumb_up"
                        app:tint="@color/md_theme_onSurfaceVariant" />

                    <TextView
                        android:id="@+id/txt_likes"
                        style="@style/TextAppearance.FMPro.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        tools:text="@string/ex_likes" />
                </LinearLayout>

                <!-- Comments Button -->
                <LinearLayout
                    android:id="@+id/lyt_comment_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:id="@+id/imv_comment"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/label_comments"
                        app:srcCompat="@drawable/ic_textsms"
                        app:tint="@color/md_theme_onSurfaceVariant" />

                    <TextView
                        style="@style/TextAppearance.FMPro.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/label_comments"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <!-- Share Button -->
                <LinearLayout
                    android:id="@+id/lyt_share_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:id="@+id/imv_share"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/label_share"
                        app:srcCompat="@drawable/ic_share"
                        app:tint="@color/md_theme_onSurfaceVariant" />

                    <TextView
                        android:id="@+id/txt_share"
                        style="@style/TextAppearance.FMPro.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/label_share"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- More Options Button -->
                <ImageView
                    android:id="@+id/bt_more"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/label_more"
                    android:focusable="true"
                    android:padding="@dimen/spacing_sm"
                    app:srcCompat="@drawable/ic_more_dot"
                    app:tint="@color/md_theme_onSurfaceVariant" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>