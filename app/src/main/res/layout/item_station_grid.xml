<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_station"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="@dimen/corner_radius_lg"
        app:cardElevation="@dimen/elevation_level1"
        app:rippleColor="?attr/colorControlHighlight"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Top Row: Logo & Live Status -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.sana.dev.fm.ui.view.RoundImageView
                    android:id="@+id/civ_logo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    app:borderColor="@color/md_theme_outlineVariant"
                    app:borderWidth="1dp"
                    app:cornerRadius="16dp"
                    app:srcCompat="@mipmap/ic_launcher" />

                <!-- Live Badge -->
                <LinearLayout
                    android:id="@+id/lyt_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/shape_round_corner"
                    android:backgroundTint="@color/md_theme_errorContainer"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/md_theme_error" />

                    <TextView
                        android:id="@+id/tv_live_status"
                        style="@style/TextAppearance.FMPro.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_live_badge"
                        android:textColor="@color/md_theme_onErrorContainer" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Station Title -->
            <TextView
                android:id="@+id/tv_station_name"
                style="@style/TextAppearance.FMPro.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/md_theme_onSurface"
                tools:text="راديو هوا اليمن" />

            <!-- Frequency and Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_frequency"
                    style="@style/TextAppearance.FMPro.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_round_corner"
                    android:backgroundTint="@color/md_theme_station_chip_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/md_theme_primary"
                    tools:text="88.3 MHz" />

                <TextView
                    android:id="@+id/tv_location"
                    style="@style/TextAppearance.FMPro.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    tools:text="صنعاء" />
            </LinearLayout>

            <!-- Divider & Action Footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:background="@color/md_theme_outlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_action_details"
                    style="@style/TextAppearance.FMPro.LabelMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_station_info"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quick_play"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/action_play_stream"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_media_play"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/md_theme_onSecondaryContainer" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
