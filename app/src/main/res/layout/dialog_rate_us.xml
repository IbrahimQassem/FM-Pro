<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="@dimen/spacing_lg"
    android:layout_marginEnd="@dimen/spacing_lg"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="@dimen/corner_radius_xl"
    app:cardElevation="@dimen/elevation_level3"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_dialog_icon_container">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_star"
                app:tint="@color/md_theme_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_rate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:fontFamily="@font/tj_bold"
            android:gravity="center"
            android:text="@string/label_like_the_app"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.FMPro.TitleLarge"
            android:textColor="@color/md_theme_onSurface" />

        <TextView
            android:id="@+id/tv_rate_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/tj_regular"
            android:gravity="center"
            android:text="@string/label_rate_us_now"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.FMPro.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/rating_bar"
            style="@style/Yellow.AppCompatRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:isIndicator="false"
            android:numStars="5"
            android:rating="5"
            android:stepSize="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.FMPro.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:minHeight="@dimen/min_touch_target_size"
                android:text="@string/label_later"
                android:textColor="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/corner_radius_full"
                app:strokeColor="@color/md_theme_outlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                style="@style/Widget.FMPro.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:minHeight="@dimen/min_touch_target_size"
                android:text="@string/label_sound_good"
                android:textColor="@color/md_theme_onPrimary"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="@dimen/corner_radius_full" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
