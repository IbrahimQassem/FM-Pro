<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@color/overlay_light_80"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/img_old_sanaa" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/min_touch_target_size"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/spacing_md"
        android:minWidth="@dimen/min_touch_target_size"
        android:text="@string/label_skip"
        android:textColor="@color/md_theme_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layoutDots"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="top|center_vertical|center_horizontal|center"
            android:orientation="horizontal" />
    </LinearLayout>
</RelativeLayout>
