<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/md_theme_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- M3 BottomSheet Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/bg_drag_handle" />

        <!-- Header: Title & Admin Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FMPro.HeadlineSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_panel_title" />

                <TextView
                    style="@style/TextAppearance.FMPro.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_name"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_admin_badge"
                style="@style/TextAppearance.FMPro.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_round_solid"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xxs"
                android:text="@string/admin_badge_title"
                android:textColor="@color/md_theme_primary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ================= ADMIN CONTROL CENTER SECTION ================= -->
        <LinearLayout
            android:id="@+id/card_admin_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.FMPro.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:text="@string/section_admin_control"
                android:textColor="@color/md_theme_primary" />

            <!-- 2-Column Administrative Action Grid -->
            <!-- Row 1: Add Episode & Add Program -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Add Episode -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lyt_add_episode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target_size"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_collections_white_24dp"
                            app:tint="@color/md_theme_primary" />

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/add_episode" />

                        <TextView
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_tile_add_episode_sub"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Add Program -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lyt_add_program"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target_size"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ballot"
                            app:tint="@color/md_theme_primary" />

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/add_program" />

                        <TextView
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_tile_add_program_sub"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Update Episodes & Update Programs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <!-- Update Episodes -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lyt_update_episode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target_size"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/md_theme_primary" />

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/update_episode" />

                        <TextView
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_tile_manage_episodes_sub"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Update Programs -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lyt_update_program"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_touch_target_size"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_date_range"
                            app:tint="@color/md_theme_primary" />

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/update_program" />

                        <TextView
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_tile_manage_programs_sub"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 3: Update Radio Info (Full Width Tile) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lyt_update_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_radio"
                        app:tint="@color/md_theme_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_radio_info" />

                        <TextView
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_tile_station_info_sub"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/md_theme_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ================= GENERAL & ACCOUNT SECTION ================= -->
        <TextView
            style="@style/TextAppearance.FMPro.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/section_general_support"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/corner_radius_md"
            app:cardElevation="@dimen/elevation_level1"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xs">

                <!-- User Account Action -->
                <LinearLayout
                    android:id="@+id/lyt_user_acc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person_pin"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.FMPro.BodyLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/user_account" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/md_theme_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:layout_marginVertical="@dimen/spacing_xxs"
                    android:background="@color/md_theme_outlineVariant" />

                <!-- Share App Action -->
                <LinearLayout
                    android:id="@+id/lyt_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_share"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.FMPro.BodyLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/share_app" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/md_theme_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:layout_marginVertical="@dimen/spacing_xxs"
                    android:background="@color/md_theme_outlineVariant" />

                <!-- Rate App Action -->
                <LinearLayout
                    android:id="@+id/lyt_get_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.FMPro.BodyLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/rate_app" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/md_theme_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:layout_marginVertical="@dimen/spacing_xxs"
                    android:background="@color/md_theme_outlineVariant" />

                <!-- About Us Action -->
                <LinearLayout
                    android:id="@+id/lyt_about_us"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/min_touch_target_size"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_sm">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_emoji_objects"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        style="@style/TextAppearance.FMPro.BodyLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/nav_about_us" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop"
                        app:tint="@color/md_theme_outline" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Close / Dismiss Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyt_make_close"
            style="@style/Widget.FMPro.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target_size"
            android:text="@string/label_hide"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
