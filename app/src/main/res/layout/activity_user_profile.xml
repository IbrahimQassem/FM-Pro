<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_surface"
        tools:context="com.sana.dev.fm.ui.activity.appuser.UserProfileActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_surface"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/md_theme_onSurface"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:title="@string/label_profile"
                app:titleTextAppearance="@style/TextAppearance.FMPro.TitleMedium"
                app:titleTextColor="@color/md_theme_onSurface" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="48dp"
            android:scrollbars="none"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm">

                <!-- 1. Hero Header Section (Avatar & Profile Overview) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/md_theme_surfaceVariant"
                    app:cardCornerRadius="@dimen/corner_radius_lg"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <!-- Avatar Container with Edit Camera Badge -->
                        <FrameLayout
                            android:id="@+id/rtl_img_parent"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:clickable="true"
                            android:focusable="true">

                            <com.sana.dev.fm.ui.view.RoundImageView
                                android:id="@+id/img_profile"
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                app:borderColor="@color/md_theme_primary"
                                app:borderWidth="2dp"
                                app:cornerRadius="48dp"
                                app:srcCompat="@drawable/ic_person" />

                            <!-- Camera Floating Action Badge -->
                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/shape_circle"
                                android:backgroundTint="@color/md_theme_primary"
                                android:elevation="4dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/pick_profile_image"
                                    app:srcCompat="@drawable/ic_photo_camera"
                                    app:tint="@android:color/white" />
                            </FrameLayout>
                        </FrameLayout>

                        <!-- User Primary Name -->
                        <TextView
                            android:id="@+id/tv_label_user_name"
                            style="@style/TextAppearance.FMPro.HeadlineSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="Ibrahim Qassem" />

                        <!-- User Email -->
                        <TextView
                            android:id="@+id/tv_label_user_email"
                            style="@style/TextAppearance.FMPro.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            tools:text="abrahimsharah99@gmail.com" />

                        <!-- User Mobile -->
                        <TextView
                            android:id="@+id/tv_label_user_mobile"
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:textDirection="ltr"
                            tools:text="775617017" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Account Information Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:cardCornerRadius="@dimen/corner_radius_lg"
                    app:cardElevation="@dimen/elevation_level1"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <!-- Section Title -->
                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:text="@string/label_personal_info"
                            android:textColor="@color/md_theme_primary" />

                        <!-- Full Name Input Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/lyt_parent_full_name"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:hint="@string/user_name"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                            app:boxStrokeColor="@color/md_theme_primary"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="@color/md_theme_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_full_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Email Input Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/lyt_parent_email"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:hint="@string/email"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                            app:boxStrokeColor="@color/md_theme_primary"
                            app:startIconDrawable="@drawable/ic_email_black"
                            app:startIconTint="@color/md_theme_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Mobile Input Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/lyt_parent_mobile"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/mobile"
                            app:boxCornerRadiusBottomEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusBottomStart="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopEnd="@dimen/corner_radius_md"
                            app:boxCornerRadiusTopStart="@dimen/corner_radius_md"
                            app:boxStrokeColor="@color/md_theme_primary"
                            app:startIconDrawable="@drawable/ic_smart_phone"
                            app:startIconTint="@color/md_theme_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_mobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789+"
                                android:inputType="phone"
                                android:textColor="@color/md_theme_onSurface"
                                android:textDirection="ltr"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Gender Preferences Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lyt_parent_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/md_theme_surface"
                    app:cardCornerRadius="@dimen/corner_radius_lg"
                    app:cardElevation="@dimen/elevation_level1"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            style="@style/TextAppearance.FMPro.TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gender"
                            android:textColor="@color/md_theme_primary" />

                        <RadioGroup
                            android:id="@+id/rg_gender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:orientation="horizontal">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_male"
                                style="@style/TextAppearance.FMPro.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/md_theme_primary"
                                android:text="@string/male"
                                android:textColor="@color/md_theme_onSurface" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/radio_female"
                                style="@style/TextAppearance.FMPro.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="@color/md_theme_primary"
                                android:text="@string/female"
                                android:textColor="@color/md_theme_onSurface" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hidden City/Country Layout for compatibility -->
                <LinearLayout
                    android:id="@+id/lyt_parent_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- 5. Admin Panel Button (visible only to ADMIN/SuperADMIN) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_panel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/admin_dashboard"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:cornerRadius="@dimen/corner_radius_md"
                    app:icon="@drawable/ic_admin_panel_settings"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_primary"
                    app:strokeColor="@color/md_theme_primary" />

                <!-- 4. Save Button Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:layout_marginHorizontal="@dimen/spacing_sm"
                    android:text="@string/label_save"
                    android:textSize="16sp"
                    app:cornerRadius="@dimen/corner_radius_md" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
