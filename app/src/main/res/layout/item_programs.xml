<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/lyt_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_md">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_level1"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Program Hero / Banner Image -->
                <ImageView
                    android:id="@+id/iv_banner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:adjustViewBounds="true"
                    android:background="@color/md_theme_surfaceVariant"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/logo_app" />

                <!-- Program Header Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm">

                    <!-- Program Logo / Avatar -->
                    <com.sana.dev.fm.ui.view.RoundImageView
                        android:id="@+id/civ_logo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        app:borderColor="@color/md_theme_outlineVariant"
                        app:borderWidth="1dp"
                        app:cornerRadius="22dp"
                        app:srcCompat="@mipmap/ic_launcher" />

                    <!-- Program Title & Tag -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/title"
                            style="@style/TextAppearance.FMPro.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="البرنامج العام" />

                        <TextView
                            android:id="@+id/tv_tag"
                            style="@style/TextAppearance.FMPro.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:visibility="gone"
                            tools:text="@string/label_tag" />
                    </LinearLayout>

                    <!-- Expand / Collapse Toggle Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bt_toggle"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/min_touch_target_size"
                        android:layout_height="@dimen/min_touch_target_size"
                        android:contentDescription="@string/more"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_expand_arrow"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/md_theme_primary" />
                </LinearLayout>

                <!-- Expandable Metadata Details Container -->
                <LinearLayout
                    android:id="@+id/lyt_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:background="@drawable/shape_round_corner"
                    android:backgroundTint="@color/md_theme_surfaceVariant"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md"
                    android:visibility="visible">

                    <!-- 1. Description Section -->
                    <LinearLayout
                        android:id="@+id/lyt_parent_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_info"
                                app:tint="@color/md_theme_primary" />

                            <TextView
                                style="@style/TextAppearance.FMPro.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/label_desc"
                                android:textColor="@color/md_theme_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_desc"
                            style="@style/TextAppearance.FMPro.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="وصف تفصيلي للبرنامج وفقراته الإذاعية" />
                    </LinearLayout>

                    <!-- 2. Program Categories Section -->
                    <LinearLayout
                        android:id="@+id/lyt_parent_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ballot"
                                app:tint="@color/md_theme_primary" />

                            <TextView
                                style="@style/TextAppearance.FMPro.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/label_program_category"
                                android:textColor="@color/md_theme_primary" />
                        </LinearLayout>

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/flex_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            app:flexWrap="wrap"
                            app:justifyContent="flex_start" />
                    </LinearLayout>

                    <!-- 3. Broadcast Date Period Section -->
                    <LinearLayout
                        android:id="@+id/lyt_parent_day_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_date_range"
                                app:tint="@color/md_theme_primary" />

                            <TextView
                                style="@style/TextAppearance.FMPro.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/label_show_date"
                                android:textColor="@color/md_theme_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_day_period"
                            style="@style/TextAppearance.FMPro.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxs"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="من ١ يناير الى ٣١ ديسمبر" />
                    </LinearLayout>

                    <!-- 4. Broadcast Weekdays Section -->
                    <LinearLayout
                        android:id="@+id/lyt_parent_show_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_access_time"
                                app:tint="@color/md_theme_primary" />

                            <TextView
                                style="@style/TextAppearance.FMPro.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/label_show_days"
                                android:textColor="@color/md_theme_primary" />
                        </LinearLayout>

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/flex_day_show"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            app:flexWrap="wrap"
                            app:justifyContent="flex_start" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</layout>