<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_parent"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardCornerRadius="@dimen/corner_radius_lg"
        app:cardElevation="@dimen/elevation_level1"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.sana.dev.fm.ui.view.RoundImageView
                    android:id="@+id/civLogo"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:scaleType="centerCrop"
                    app:borderColor="@color/md_theme_outlineVariant"
                    app:borderWidth="1dp"
                    app:cornerRadius="50dp"
                    app:srcCompat="@mipmap/ic_launcher" />

                <ImageView
                    android:id="@+id/iv_badge_image"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    app:srcCompat="@drawable/ic_verified"
                    app:tint="@color/md_theme_primary" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.FMPro.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/md_theme_onSurface"
                tools:text="@string/label_radio_station" />

            <TextView
                android:id="@+id/tv_freq"
                style="@style/TextAppearance.FMPro.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/shape_round_corner"
                android:backgroundTint="@color/md_theme_station_chip_bg"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/md_theme_primary"
                tools:text="99.9 FM" />

            <ImageView
                android:id="@+id/iv_internet"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:srcCompat="@drawable/shape_circle"
                tools:ignore="UseAppTint" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>