<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="@dimen/spacing_lg"
    android:layout_marginEnd="@dimen/spacing_lg"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="@dimen/corner_radius_xl"
    app:cardElevation="@dimen/elevation_level3"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header with Close Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md">

            <ImageButton
                android:id="@+id/bt_close"
                android:layout_width="@dimen/min_touch_target_size"
                android:layout_height="@dimen/min_touch_target_size"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_close"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/md_theme_onSurfaceVariant" />
        </FrameLayout>

        <!-- App Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <ImageView
                android:id="@+id/civ_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/logo_app" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/tj_bold"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.FMPro.TitleLarge"
                android:textColor="@color/md_theme_primary"
                tools:text="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:fontFamily="@font/tj_medium"
                android:text="@string/app_slogan"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.FMPro.BodyMedium"
                android:textColor="@color/md_theme_onSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/tj_regular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/label_app_description"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.FMPro.BodySmall"
                android:textColor="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_outlineVariant" />

        <!-- Contact Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_surfaceVariant"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tj_medium"
                android:text="@string/label_contact_us"
                android:textAppearance="@style/TextAppearance.FMPro.LabelMedium"
                android:textColor="@color/md_theme_onSurfaceVariant" />

            <!-- Social / Contact Icons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/iv_whats"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_whatsapp"
                    app:srcCompat="@drawable/ic_whatsapp"
                    app:tint="@color/md_theme_primary" />

                <ImageButton
                    android:id="@+id/iv_mobile"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_mobile"
                    app:srcCompat="@drawable/ic_smart_phone"
                    app:tint="@color/md_theme_primary" />

                <ImageButton
                    android:id="@+id/iv_email"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/email"
                    app:srcCompat="@drawable/ic_email_black"
                    app:tint="@color/md_theme_primary" />

                <ImageButton
                    android:id="@+id/iv_facebook"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_facebook"
                    app:srcCompat="@drawable/ic_social_facebook"
                    app:tint="@color/md_theme_primary" />

                <ImageButton
                    android:id="@+id/iv_twitter"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_twitter"
                    app:srcCompat="@drawable/ic_social_twitter"
                    app:tint="@color/md_theme_primary" />

                <ImageButton
                    android:id="@+id/iv_instagram"
                    android:layout_width="@dimen/min_touch_target_size"
                    android:layout_height="@dimen/min_touch_target_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_instagram"
                    app:srcCompat="@drawable/ic_social_instagram"
                    app:tint="@color/md_theme_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Powered By Portfolio Button -->
            <FrameLayout
                android:id="@+id/bt_portfolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/tj_medium"
                    android:text="@string/powered_by"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelSmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
