<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Banner Slider Section -->
        <RelativeLayout
            android:id="@+id/lyt_banner_container"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginBottom="@dimen/spacing_sm">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/dotsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="6dp"
                android:background="@color/transparent"
                android:gravity="center"
                android:orientation="horizontal" />

        </RelativeLayout>

        <!-- Search Bar Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_level1"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/label_search_hint"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/md_theme_onSurfaceVariant" />

                <EditText
                    android:id="@+id/et_search_radios"
                    style="@style/TextAppearance.FMPro.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_search_radios"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:textColor="@color/md_theme_onSurface"
                    android:textColorHint="@color/md_theme_onSurfaceVariant" />

                <ImageView
                    android:id="@+id/iv_clear_search"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_close"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/md_theme_onSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Filter Chips Section -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_md"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sanaa"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_sanaa"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_aden"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_aden"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_news"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_news"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelMedium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_culture"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_culture"
                    android:textAppearance="@style/TextAppearance.FMPro.LabelMedium" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Section Header (Title & Counter) -->
        <LinearLayout
            android:id="@+id/lyt_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_xs">

            <TextView
                android:id="@+id/tv_section_title"
                style="@style/TextAppearance.FMPro.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_available_stations"
                android:textColor="@color/md_theme_onSurface" />

            <TextView
                android:id="@+id/tv_stations_count"
                style="@style/TextAppearance.FMPro.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_round_corner"
                android:backgroundTint="@color/md_theme_surfaceVariant"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                tools:text="8 محطات" />

            <ImageButton
                android:id="@+id/ib_view_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_change_view"
                app:srcCompat="@drawable/ic_ballot"
                app:tint="@color/md_theme_onSurfaceVariant" />

        </LinearLayout>

        <!-- Stations Grid RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stations_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp" />

        <!-- Empty Results View -->
        <LinearLayout
            android:id="@+id/lyt_empty_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_search"
                app:tint="@color/md_theme_onSurfaceVariant" />

            <TextView
                style="@style/TextAppearance.FMPro.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/no_matching_stations"
                android:textColor="@color/md_theme_onSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
