rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isKnownRoot(root) {
      return root == 'HudHudFM'
        || root == 'HudHudFmGooglePlay'
        || root == 'InterNews'
        || root == 'HudHudFM_Folder'
        || root == 'HudHudFmGooglePlay_Folder'
        || root == 'InterNews_Folder';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidImage(maxSize) {
      return request.resource != null
        && request.resource.size <= maxSize
        && request.resource.contentType.matches('image/.*');
    }

    function isValidAudio() {
      return request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');
    }

    // ==========================================
    // CANONICAL STRUCTURED STORAGE
    // ==========================================

    // User Avatars (Owner or Admin only, <= 2MB)
    match /{root}/users/{uid}/{fileName} {
      allow read: if isKnownRoot(root);
      allow create, update: if isKnownRoot(root) && (isOwner(uid) || isAdmin()) && isValidImage(2 * 1024 * 1024);
      allow delete: if isKnownRoot(root) && (isOwner(uid) || isAdmin());
    }

    // Station Logos (Admin only, <= 5MB)
    match /{root}/stations/{stationId}/{fileName} {
      allow read: if isKnownRoot(root);
      allow create, update: if isKnownRoot(root) && isAdmin() && isValidImage(5 * 1024 * 1024);
      allow delete: if isKnownRoot(root) && isAdmin();
    }

    // Program Covers (Admin only, <= 5MB)
    match /{root}/programs/{programId}/{fileName} {
      allow read: if isKnownRoot(root);
      allow create, update: if isKnownRoot(root) && isAdmin() && isValidImage(5 * 1024 * 1024);
      allow delete: if isKnownRoot(root) && isAdmin();
    }

    // Episode Media - Covers and Audios (Admin only)
    match /{root}/episodes/{episodeId}/{fileName} {
      allow read: if isKnownRoot(root);
      allow create, update: if isKnownRoot(root) && isAdmin() && (isValidImage(5 * 1024 * 1024) || isValidAudio());
      allow delete: if isKnownRoot(root) && isAdmin();
    }

    // Banner Images (Admin only, <= 5MB)
    match /{root}/banners/{bannerId}/{fileName} {
      allow read: if isKnownRoot(root);
      allow create, update: if isKnownRoot(root) && isAdmin() && isValidImage(5 * 1024 * 1024);
      allow delete: if isKnownRoot(root) && isAdmin();
    }

    // ==========================================
    // LEGACY STORAGE PATHS (Preserved)
    // ==========================================
    match /{folder}/{ownerId}/{fileName} {
      allow read: if isKnownRoot(folder);
      allow create, update: if isKnownRoot(folder)
        && (isAdmin() || isOwner(ownerId))
        && isValidImage(5 * 1024 * 1024);
      allow delete: if isKnownRoot(folder)
        && (isAdmin() || isOwner(ownerId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
