+// Ordinary reporting coverage observes actual model SDK method calls. It does
+// not replace tool budgeting, claim internal transport/billing reads or add a seam.
+function observeCountModelReads(raw) {
+  const events = [], originalDoc = raw.doc.bind(raw), originalQuery = raw.query.bind(raw), originalTransaction = raw.runTransaction.bind(raw);
+  raw.doc = path => {
+    const reference = originalDoc(path), get = reference.get;
+    reference.get = async () => { events.push({ kind: 'document', path, equivalents: 1 }); return get(); };
+    return reference;
+  };
+  raw.query = options => {
+    const query = originalQuery(options), get = query.get;
+    query.get = async () => { const snapshot = await get(); events.push({ kind: 'query', path: options.path ?? options.group, equivalents: Math.max(1, snapshot.size) }); return snapshot; };
+    return query;
+  };
+  raw.runTransaction = (operation, options) => originalTransaction(tx => operation(new Proxy(tx, {
+    get(target, property) {
+      if (property === 'get') return async reference => {
+        // The model dispatches query gets through query.get; count them there
+        // once. Point transaction gets call snapshot directly, so observe here.
+        if (!reference._query) events.push({ kind: 'transaction-document', path: reference.path, equivalents: 1 });
+        return target.get(reference);
+      };
+      const value = target[property]; return typeof value === 'function' ? value.bind(target) : value;
+    },
+  })), options);
+  return { events, reset: () => { events.length = 0; }, total: () => events.reduce((sum, event) => sum + event.equivalents, 0) };
