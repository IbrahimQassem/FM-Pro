+    const original = await authenticatedReviewReplay(f);
+    assert.equal(original.value.lastEpisode, null); assert.equal(original.value.lastHead, null);
+    await publishReviewReplayType(f, original, field, invalid);
+    const before = await readFile(original.path), writes = f.raw.writes.length;
+    await assert.rejects(fullTool.applyCommentCountReconciliation({ ...f.input, maxItems: 1 }),
